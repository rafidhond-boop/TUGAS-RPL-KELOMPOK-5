        <mxCell id="uAj_lDrzpF7nK8eTsgfw-60" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;labelBackgroundColor=none;" value="&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;CATATAN&amp;nbsp;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- &lt;b&gt;user1&lt;/b&gt; (admin) membuat &lt;b&gt;session1 &lt;/b&gt;(login aktif)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- &lt;b&gt;user1 &lt;/b&gt;mencatat tiga TransaksiKas (trans1, trans2, trans3).&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- &lt;b&gt;trans1 &lt;/b&gt;dan &lt;b&gt;trans3 &lt;/b&gt;adalah iuran yang dibayar oleh &lt;b&gt;warga1 &lt;/b&gt;dan &lt;b&gt;warga2&lt;/b&gt;.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- &lt;b&gt;trans2 &lt;/b&gt;adalah pengeluaran umum, tidak terkait warga tertentu.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;- Total Saldo Kas RT saat snapshot adalah Rp.20.000 (50.000+50.00- 120.000).&lt;/font&gt;&lt;/div&gt;" vertex="1">
