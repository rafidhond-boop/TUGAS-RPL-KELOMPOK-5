          <mxGeometry x="915" y="255" width="205" height="75" as="geometry" />
        </mxCell>
        <mxCell id="cache" value="&amp;lt;&amp;lt;node&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;Cache Server&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#c8a64b;strokeWidth=2;fontStyle=1;fontSize=16;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="520" y="445" width="210" height="170" as="geometry" />
        </mxCell>
        <mxCell id="redis" value="&amp;lt;&amp;lt;database&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;Redis&lt;/b&gt;&lt;br&gt;(Cache / Session)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="535" y="515" width="180" height="85" as="geometry" />
        </mxCell>
        <mxCell id="db" value="&amp;lt;&amp;lt;node&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;Database Server&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#c8a64b;strokeWidth=2;fontStyle=1;fontSize=16;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="820" y="445" width="220" height="170" as="geometry" />
        </mxCell>
        <mxCell id="mysql" value="&amp;lt;&amp;lt;database&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;MySQL&lt;/b&gt;&lt;br&gt;(Data Warga, Data Transaksi, User)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="835" y="515" width="190" height="85" as="geometry" />
        </mxCell>
        <mxCell id="storage" value="&amp;lt;&amp;lt;node&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;File Storage Server&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#c8a64b;strokeWidth=2;fontStyle=1;fontSize=16;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1120" y="445" width="220" height="170" as="geometry" />
        </mxCell>
        <mxCell id="files" value="&amp;lt;&amp;lt;artifact&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;File Upload&lt;/b&gt;&lt;br&gt;(Lampiran Transaksi SIRTES)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1135" y="515" width="190" height="85" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="HTTPS (443)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeWidth=1.5;" edge="1" parent="1" source="client" target="internet">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="HTTPS (443)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeWidth=1.5;" edge="1" parent="1" source="internet" target="web">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="HTTP (8080)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="nginx" target="docker">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="TCP (6379)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="spring" target="cache">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="TCP (3306)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="war" target="mysql">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="HTTPS / SFTP (443 / 22)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="app" target="storage">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="desc" value="&lt;b&gt;DESKRIPSI DEPLOYMENT&lt;/b&gt;&lt;br&gt;1. Client (Browser) mengakses aplikasi melalui Internet menggunakan HTTPS (443).&lt;br&gt;2. Request diterima Web Server (Nginx) sebagai reverse proxy dan diteruskan ke Application Server.&lt;br&gt;3. Application Server menjalankan aplikasi SIRTES dalam container Docker pada port 8080.&lt;br&gt;4. Aplikasi terhubung ke Database Server (MySQL) untuk menyimpan data utama.&lt;br&gt;5. Redis digunakan sebagai cache dan session login (port 6379).&lt;br&gt;6. File lampiran disimpan pada File Storage Server melalui HTTPS atau SFTP." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=left;verticalAlign=top;spacing=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="680" width="760" height="240" as="geometry" />
        </mxCell>
        <mxCell id="spec" value="&lt;b&gt;SPESIFIKASI NODE&lt;/b&gt;&lt;br&gt;&lt;b&gt;Client Device&lt;/b&gt; : Perangkat pengguna (Laptop/Smartphone) menjalankan browser.&lt;br&gt;&lt;b&gt;Web Server&lt;/b&gt; : Nginx Reverse Proxy.&lt;br&gt;&lt;b&gt;Application Server&lt;/b&gt; : Menjalankan aplikasi dalam container Docker.&lt;br&gt;&lt;b&gt;Database Server&lt;/b&gt; : MySQL untuk penyimpanan data.&lt;br&gt;&lt;b&gt;Cache Server&lt;/b&gt; : Redis untuk cache &amp;amp; session.&lt;br&gt;&lt;b&gt;File Storage Server&lt;/b&gt; : Penyimpanan file lampiran transaksi." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;align=left;verticalAlign=top;spacing=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="830" y="680" width="510" height="240" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  </mxfile>