        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam shadowing false\nskinparam DefaultTextAlignment center\n\n&#39; Definisi Warna Berdasarkan Kategori Dosen\nskinparam ClassBackgroundColor&lt;&lt;Utama&gt;&gt; #FFF2CC\nskinparam ClassBackgroundColor&lt;&lt;Master&gt;&gt; #D5E8D4\nskinparam ClassBackgroundColor&lt;&lt;Referensi&gt;&gt; #DAE8FC\nskinparam ClassBackgroundColor&lt;&lt;Pendukung&gt;&gt; #F8CECC\n\nclass User &lt;&lt;Utama&gt;&gt; {\n    + id: int (PK)\n    + name: string\n    + email: string (unique)\n    + password: string\n    + role: string\n    + created_at: datetime\n    + register(): bool\n    + login(email, password): bool\n    + updateProfile(data): void\n    + logout(): void\n}\n\nclass Warga &lt;&lt;Master&gt;&gt; {\n    + id: int (PK)\n    + user_id: int (FK)\n    + nik: string (unique)\n    + nama_lengkap: string\n    + alamat: string\n    + no_telepon: string\n    + status_tinggal: string\n    + saveData(): bool\n    + updateData(): bool\n    + deleteData(): bool\n    + searchWarga(keyword): List&lt;Warga&gt;\n}\n\nclass Transaksi &lt;&lt;Utama&gt;&gt; {\n    + id: int (PK)\n    + user_id: int (FK)\n    + warga_id: int (FK)\n    + jenis_transaksi: string\n    + nominal: decimal\n    + tanggal: datetime\n    + keterangan: text\n    + bukti_pembayaran: string\n    + status_verifikasi: string\n    + saveTransaksi(): Transaksi\n    + updateTransaksi(): bool\n    + deleteTransaksi(): bool\n    + validasiTransaksi(): bool\n}\n\nclass Saldo &lt;&lt;Pendukung&gt;&gt; {\n    + id: int (PK)\n    + total_kas_masuk: decimal\n    + total_kas_keluar: decimal\n    + saldo_akhir: decimal\n    + updated_at: datetime\n    + hitungSaldoOtomatis(): decimal\n    + getSaldoTerkini(): Saldo\n}\n\nclass Laporan &lt;&lt;Referensi&gt;&gt; {\n    + id: int (PK)\n    + user_id: int (FK)\n    + periode: string\n    + jenis_laporan: string\n    + generated_at: datetime\n    + generateLaporan(): Laporan\n    + exportPDF(): File\n    + exportExcel(): File\n}\n\nUser \&quot;1\&quot; -- \&quot;0..*\&quot; Warga : mengelola &gt;\nUser \&quot;1\&quot; -- \&quot;0..*\&quot; Transaksi : mencatat &gt;\nWarga \&quot;1..1\&quot; -- \&quot;0..*\&quot; Transaksi : memiliki &gt;\nTransaksi \&quot;1..*\&quot; -- \&quot;1\&quot; Saldo : memperbarui &gt;\nUser \&quot;1\&quot; -- \&quot;0..*\&quot; Laporan : mencetak &gt;\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="KpBYA_FpLe8RpHyWpoSA-130">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
