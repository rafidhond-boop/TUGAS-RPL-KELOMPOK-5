        <UserObject label="Sequence Diagram - Mencatat Iuran &amp;amp; Validasi Pembayaran" plantUmlId="title_35" plantUmlBaseStyle="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;" plantUmlBaseValue="Sequence Diagram - Mencatat Iuran &amp;amp; Validasi Pembayaran" id="jF6bvUA7w9xk5lmDXBtw-37">
          <mxCell parent="jF6bvUA7w9xk5lmDXBtw-1" style="text;html=1;fillColor=none;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#000000;align=center;verticalAlign=middle;" vertex="1">
